<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="192dp"
    android:height="192dp"
    android:viewportWidth="192"
    android:viewportHeight="192">

    <!-- Main sphere body -->
    <path android:pathData="M96,16 A80,80 0 1,1 95.9,16 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="72"
                android:centerY="64"
                android:gradientRadius="100">
                <item android:offset="0" android:color="#A5D8FF"/>
                <item android:offset="0.4" android:color="#4DABF7"/>
                <item android:offset="0.75" android:color="#1C7ED6"/>
                <item android:offset="1" android:color="#0B4F8C"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Highlight -->
    <path
        android:pathData="M60,40 A35,28 0 1,1 59.9,40 Z"
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.35"/>

    <!-- Soft inner glow -->
    <path
        android:pathData="M80,55 A22,18 0 1,1 79.9,55 Z"
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.2"/>
</vector>
